# ==============================================================================
# NEXUS AI — Environment Configuration
# Copy this file to .env and adjust variables for your local or production setup.
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
LOG_LEVEL=INFO

# Business & Localization Defaults
DEFAULT_BUSINESS_ID=1
DEFAULT_TIMEZONE=Asia/Tashkent
DEFAULT_CURRENCY=UZS

# Database Configuration
# Local SQLite Async (default for Windows local dev)
DATABASE_URL=sqlite+aiosqlite:///./nexus_ai.db
# Production PostgreSQL Async example:
# DATABASE_URL=postgresql+asyncpg://nexus_user:nexus_password@localhost:5432/nexus_ai

# Security & Authentication
SESSION_SECRET=change_this_to_a_super_secure_random_hex_key_at_least_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Telegram Bot Integration
# Obtain from @BotFather on Telegram (optional in test/mock mode)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# Google Gemini AI Integration
# Obtain from Google AI Studio (optional: offline Mock AI engine used if empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MOCK_MODE=false
